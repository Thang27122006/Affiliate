# ==========================================
# GÓC PHỤ KIỆN - ENVIRONMENT CONFIGURATION (SAMPLE)
# Sao chép file này thành .env và điền thông tin môi trường thực tế
# KHÔNG COMMIT FILE .env LÊN GIT REPOSITORY!
# ==========================================

# Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SETTINGS_MODULE=config.settings.development

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gocphukien
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Timezone & Localization
TIME_ZONE=Asia/Ho_Chi_Minh
LANGUAGE_CODE=vi
