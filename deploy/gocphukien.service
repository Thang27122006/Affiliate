[Unit]
Description=Gunicorn daemon for Goc Phu Kien Web Application
After=network.target postgresql.service

[Service]
User=tmthang
Group=tmthang
WorkingDirectory=/home/tmthang/Affiliate
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
EnvironmentFile=/home/tmthang/Affiliate/.env
ExecStart=/home/tmthang/Affiliate/.venv/bin/gunicorn -c deploy/gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
PrivateTmp=true
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
